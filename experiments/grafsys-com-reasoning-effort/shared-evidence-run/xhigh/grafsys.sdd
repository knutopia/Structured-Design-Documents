        + Component C-008 "WordPress attribution link"
          label="Create a website or blog at WordPress.com"
          href="https://wordpress.com/?ref=footer_custom_svg"
          classification="external attribution link"
          EMITS E-003 "Activate WordPress attribution link"
          CONTAINS C-009 "WordPress attribution image"
