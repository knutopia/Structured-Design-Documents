    route_or_key="/"
    url="https://grafsys.com/"
    page_title="Graf Systems - Solutions & Design"
    observed_same_structure="Desktop and mobile snapshots expose the same accessibility structure"
    boundary="No additional same-site navigation pages were visible"
    CONTAINS VS-001 "Default homepage view"
    NAVIGATES_TO P-001 "Homepage" [E-002] observed_link_label="Graf Systems" observed_url=https://grafsys.com/
    + ViewState VS-001 "Default homepage view"
      evidence="Skip link, main article, H1, logo image, tagline paragraph, footer home link, and WordPress attribution link"
      COMPOSED_OF C-001 "Skip to content link"
      COMPOSED_OF C-002 "Main article"
      COMPOSED_OF C-006 "Site footer"
      + Component C-001 "Skip to content link"
        label="Skip to content"
        href="#content"
        classification="in-page skip link"
        EMITS E-001 "Activate skip to content"
      END
      + Component C-002 "Main article"
        role="main article"
        CONTAINS C-003 "H1 Graf Systems"
        CONTAINS C-004 "Logo image"
        CONTAINS C-005 "Tagline paragraph"
