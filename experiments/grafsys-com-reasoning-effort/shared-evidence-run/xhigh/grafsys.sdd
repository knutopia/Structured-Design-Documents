          text="Graf Systems"
          level=1
        END
        + Component C-004 "Logo image"
          accessible_name="Graf Systems"
        END
        + Component C-005 "Tagline paragraph"
          text="Solutions & Design by Knut Graf"
        END
      END
      + Component C-006 "Site footer"
        role="contentinfo"
        CONTAINS C-007 "Footer home link"
        CONTAINS C-008 "WordPress attribution link"
        + Component C-007 "Footer home link"
          label="Graf Systems"
          href="https://grafsys.com/"
