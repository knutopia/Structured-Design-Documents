SDD-TEXT 0.2

Place P-700 "Dense Review"
  route_or_key=/dense
  access=auth
  CONTAINS VS-700a "Editing"
  CONTAINS VS-700b "Done"
  COMPOSED_OF C-700 "Review Form"
END

Place P-701 "Sparse Review"
  route_or_key=/sparse
  access=auth
END

Place P-702 "Summary Review"
  route_or_key=/summary
  access=auth
  COMPOSED_OF C-702 "Summary Card"
END

ViewState VS-700a "Editing"
  place_id=P-700
  data_required=DraftRecord
  TRANSITIONS_TO VS-700b "Done" [E-700]
END

ViewState VS-700b "Done"
  place_id=P-700
  data_required=Receipt
END

Component C-700 "Review Form"
  BINDS_TO D-700 "ReviewRecord" field=status
  EMITS E-700 "Submit Review"
END

Component C-702 "Summary Card"
END

Event E-700 "Submit Review"
END

DataEntity D-700 "ReviewRecord"
END

Component C-710 "Review workspace"
  CONTAINS C-700 "Review Form"
  CONTAINS C-702 "Summary Card"
END

Component C-800 "Search field"
  description="Provides context for the current selection and explains the next available action."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-801 "Category filter"
  description="Reusable control for the help center."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-802 "Locale picker"
  description="Reusable control for the help center."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-803 "Result count"
  description="Provides context for the current selection and explains the next available action."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-804 "Article card"
  description="Reusable control for the help center."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-805 "Feedback prompt"
  description="Reusable control for the help center."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-806 "Contact link"
  description="Provides context for the current selection and explains the next available action."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-807 "Loading indicator"
  description="Reusable control for the help center."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-808 "Empty results"
  description="Reusable control for the help center."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-809 "Sort control"
  description="Provides context for the current selection and explains the next available action."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-810 "Breadcrumbs"
  description="Reusable control for the help center."
  inputs="query,locale"
  outputs=queryChanged
END

Component C-811 "Status banner"
  description="Reusable control for the help center."
  inputs="currentSelection"
  outputs=selectionChanged
END

Component C-812 "Help shortcut"
  description="Provides context for the current selection and explains the next available action."
  inputs="query,locale"
  outputs=queryChanged
END

Event E-800 "Search requested"
END

DataEntity D-800 "Help article"
END

SystemAction SA-800 "Find relevant articles"
END

Event E-801 "Feedback submitted"
END
