    intent="I see whether one or several connections fit"
    success_criteria="I only make another choice when it is needed."
    kind=decision
    PRECEDES J-1306 {one clear connection}
    PRECEDES J-1307 {several valid connections}
  END
  + Step J-1306 "I receive the clear connection to review"
    owner="Product Experience"
    description="The guidance returns the one valid outgoing connection without changing my document."
    actor="Document author"
    intent="I receive the clear connection to review"
    success_criteria="I can review the complete proposal before the app offers Save or Cancel."
  END
  + Step J-1307 "I choose what the connection means"
    owner="Product Experience"
    description="I select the exact connection from the short list that is valid between these two items."
    actor="Document author"
    intent="I choose what the connection means"
    success_criteria="The proposal reflects the meaning I intended."
    PRECEDES J-1308
  END
  + Step J-1308 "I receive my chosen connection to review"
    owner="Product Experience"
    description="The guidance returns the disambiguated outgoing connection without changing my document."
    actor="Document author"
    intent="I receive my chosen connection to review"
    success_criteria="I can review the complete proposal before the app offers Save or Cancel."
  END
END
