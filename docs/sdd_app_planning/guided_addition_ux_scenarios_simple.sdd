    success_criteria="I can compare destinations without seeing choices that cannot connect from my starting item."
    PRECEDES J-1304
  END
  + Step J-1304 "I choose the destination that fits"
    owner="Product Experience"
    description="I select the existing destination I had in mind."
    actor="Document author"
    intent="I choose the destination that fits"
    success_criteria="The experience knows both endpoints and whether the connection is already unambiguous."
    PRECEDES J-1305
  END
  + Step J-1305 "I see whether one or several connections fit"
    owner="Product Experience"
    description="If only one connection is valid, no extra question is asked; if several are valid, I am asked to choose."
