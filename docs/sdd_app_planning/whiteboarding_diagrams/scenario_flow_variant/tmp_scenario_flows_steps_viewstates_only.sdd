SDD-TEXT 0.1

# SDD for SDD
# Only steps & viewstates

# Scenario Flows: (we are missing multiple-flow markup)

Step J-010 "Select a Node"
  description="Select a Node in Source viewer or in Diagram viewer"
  PRECEDES J-020 "Review Diagrams Containing Current Node"
  PRECEDES J-040 "Add Relationship"
END

Step J-020 "Review Diagrams Containing Current Node"
  description="See the set of diagrams in which the current node appears"
  PRECEDES J-021 "Select Diagram"
  REALIZED_BY VS-050 "Browse Diagrams Containing Current Node"
END

Step J-040 "Add Relationship"
  description="Add a relationship to an existing node"
  PRECEDES J-041 "Add relationship, by node"
  PRECEDES J-042 "Add outgoing relationship"
  PRECEDES J-043 "Add incoming relationship"
  REALIZED_BY VS-010 "Add Relationship Method Choice"
END

Step J-041 "Add relationship, by node"
  description="Add relationship, by choosing another node first (incoming or outgoing)"
  REALIZED_BY VS-020 "Add Relationship by Node"
END

Step J-042 "Add outgoing relationship"
  description="Add outgoing relationship, by choosing the relationship type or a node first"
  REALIZED_BY VS-030 "Add Outgoing Relationship"
END

Step J-043 "Add incoming relationship"
  description="Add incoming relationship, by choosing the relationship type or a node first"
  REALIZED_BY VS-040 "Add Incoming Relationship"
END

Step J-021 "Select Diagram"
  description="Choose a diagram in which the node is used"
  PRECEDES J-022 "View Node in New Diagram Context"
END

Step J-022 "View Node in New Diagram Context"
  description="View the chosen diagram using the current node"
  REALIZED_BY VS-006 "Diagram Browsing, Single Node Selected"
END

Step J-030 "Select Diagram Content"
  description="Select a node or multiple nodes in a diagram"
  PRECEDES J-031 "Adjust View"
  # PRECEDES J-032 "Name the New View" ...this crashes scenario_flow renderer
END

Step J-031 "Adjust View"
  description="Make the view just right"
  PRECEDES J-032 "Name the New View"
END

Step J-032 "Name the New View"
  description="Enter a name for the new view"
END

# ViewStates, Components (UI Contracts)

ViewState VS-004 "Diagram Browsing, No Selection"
  description="Diagram browsing while nothing is selected"
  TRANSITIONS_TO VS-006 "Diagram Browsing, Single Node Selected" ["Select Node"]
END

ViewState VS-006 "Diagram Browsing, Single Node Selected"
  description="Browsing a diagram while a single node is selected, enabling single select actions"
  TRANSITIONS_TO VS-010 "Add Relationship Method Choice" ["Select: Add Relationship"]
  TRANSITIONS_TO VS-004 "Diagram Browsing, No Selection" ["Cancel Selection"]
  TRANSITIONS_TO VS-050 "Browse Diagrams Containing Current Node" ["Select: Diagrams Containing This Node"]
END

ViewState VS-050 "Browse Diagrams Containing Current Node"
  description="Browse diagrams in which the currently selected node appears"
  TRANSITIONS_TO VS-060 "Diagram Selection Confirmation" ["Select Diagram"]
END

ViewState VS-060 "Diagram Selection Confirmation"
  description="Confirms the selected diagram containing the current node"
END

ViewState VS-010 "Add Relationship Method Choice"
  description="Choose by which method to add a relationship to a node"
  TRANSITIONS_TO VS-020 "Add Relationship by Node"
  TRANSITIONS_TO VS-030 "Add Outgoing Relationship"
  TRANSITIONS_TO VS-040 "Add Incoming Relationship"
END

ViewState VS-020 "Add Relationship by Node"
  description="(Multiple sub-states:) choose target node, choose relationship type"
END

ViewState VS-030 "Add Outgoing Relationship"
  description="(Multiple sub-states:) choose relationship type, choose or created destination node"
END

ViewState VS-040 "Add Incoming Relationship"
  description="(Multiple sub-states:) choose relationship type, choose or create originating node"
END
