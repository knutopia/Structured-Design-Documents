SDD-TEXT 0.2
Diagram DG-001 "Node Pivot"
  diagram_type=scenario_flow
END

Diagram DG-002 "Add Relationship"
  diagram_type=scenario_flow
END

Diagram DG-003 "Create New View"
  diagram_type=scenario_flow
END

# SDD for SDD
# Only steps

# Named scenario flows: Node Pivot, Add Relationship, and Create New View

ScenarioStep J-010 "Select a Node"
  description="Select a Node in Source viewer or in Diagram viewer"
  PRECEDES J-020 "Review Diagrams Containing Current Node" diagrams=DG-001
  PRECEDES J-040 "Add Relationship" diagrams=DG-002
END

ScenarioStep J-020 "Review Diagrams Containing Current Node"
  description="See the set of diagrams in which the current node appears"
  PRECEDES J-021 "Select Diagram" diagrams=DG-001
  # REALIZED_BY VS-050 "Browse Diagrams Containing Current Node"
END

ScenarioStep J-040 "Add Relationship"
  description="Add a relationship to an existing node"
  PRECEDES J-041 "Add relationship, by node" diagrams=DG-002
  PRECEDES J-042 "Add outgoing relationship" diagrams=DG-002
  PRECEDES J-043 "Add incoming relationship" diagrams=DG-002
  # REALIZED_BY VS-010 "Add Relationship Method Choice"
END

ScenarioStep J-041 "Add relationship, by node"
  description="Add relationship, by choosing another node first (incoming or outgoing)"
  # REALIZED_BY VS-020 "Add Relationship by Node"
END

ScenarioStep J-042 "Add outgoing relationship"
  description="Add outgoing relationship, by choosing the relationship type or a node first"
  # REALIZED_BY VS-030 "Add Outgoing Relationship"
END

ScenarioStep J-043 "Add incoming relationship"
  description="Add incoming relationship, by choosing the relationship type or a node first"
  # REALIZED_BY VS-040 "Add Incoming Relationship"
END

ScenarioStep J-021 "Select Diagram"
  description="Choose a diagram in which the node is used"
  PRECEDES J-022 "View Node in New Diagram Context" diagrams=DG-001
END

ScenarioStep J-022 "View Node in New Diagram Context"
  description="View the chosen diagram using the current node"
  # REALIZED_BY VS-006 "Diagram Browsing, Single Node Selected"
END

ScenarioStep J-030 "Select Diagram Content"
  description="Select a node or multiple nodes in a diagram"
  PRECEDES J-031 "Adjust View" diagrams=DG-003
  # PRECEDES J-032 "Name the New View" ...this crashes scenario_flow renderer
END

ScenarioStep J-031 "Adjust View"
  description="Make the view just right"
  PRECEDES J-032 "Name the New View" diagrams=DG-003
END

ScenarioStep J-032 "Name the New View"
  description="Enter a name for the new view"
END
