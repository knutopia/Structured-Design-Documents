digraph journey_map {
  rankdir=LR;
  graph [fontname="Public Sans"];
  node [shape=box, style="rounded", fontname="Public Sans"];
  edge [fontname="Public Sans"];
  subgraph cluster_G_100 {
    label="Discover a cooking class";
    style="rounded";
    "G-100__anchor" [label="", shape=point, width=0, height=0, style=invis];
    "J-101" [label="Find an appealing class"];
    "J-102" [label="Review the class details"];
  }
  subgraph cluster_G_200 {
    label="Reserve a place";
    style="rounded";
    "G-200__anchor" [label="", shape=point, width=0, height=0, style=invis];
    "J-201" [label="Choose how to attend"];
    "J-202" [label="Book an in-person seat"];
    "J-203" [label="Book the online session"];
    "J-204" [label="Confirm the registration"];
  }
  subgraph cluster_G_300 {
    label="Prepare and enjoy";
    style="rounded";
    "G-300__anchor" [label="", shape=point, width=0, height=0, style=invis];
    "J-301" [label="Review preparation details"];
    "J-303" [label="Enjoy the cooking class"];
  }
  "G-100__anchor" -> "G-200__anchor" [style=invis, weight=100];
  "G-200__anchor" -> "G-300__anchor" [style=invis, weight=100];
  "G-100__anchor" -> "J-101" [style=invis, weight=100];
  "G-200__anchor" -> "J-201" [style=invis, weight=100];
  "J-202" -> "J-203" [style=invis, weight=100];
  "G-300__anchor" -> "J-301" [style=invis, weight=100];
  "J-101" -> "J-102";
  "J-102" -> "J-201";
  "J-201" -> "J-202";
  "J-201" -> "J-203";
  "J-202" -> "J-204";
  "J-203" -> "J-204";
  "J-204" -> "J-301";
  "J-301" -> "J-303";
}
