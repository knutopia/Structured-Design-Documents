digraph ui_contracts {
  rankdir=LR;
  graph [fontname="Public Sans", compound=true, nodesep=0.7, ranksep=1.0];
  node [fontname="Public Sans"];
  edge [fontname="Public Sans"];
  subgraph cluster_P_410 {
    graph [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT">Departure Desk</TD></TR></TABLE>>, style="rounded", labelloc="t", labeljust="l"];
    "P-410__anchor" [label="", shape="point", width=0, height=0, style="invis"];
    subgraph cluster_VS_410a {
      graph [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT">ViewState: Staging</TD></TR></TABLE>>, style="rounded,dashed", labelloc="t", labeljust="l"];
      "VS-410a__anchor" [label="", shape="point", width=0, height=0, style="invis"];
      "C-460" [shape="box", style="rounded", label="Crew Note"];
    }
    subgraph cluster_VS_410b {
      graph [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0"><TR><TD ALIGN="LEFT">ViewState: Released</TD></TR></TABLE>>, style="rounded,dashed", labelloc="t", labeljust="l"];
      "VS-410b__anchor" [label="", shape="point", width=0, height=0, style="invis"];
      "C-460" [shape="box", style="rounded", label="Crew Note"];
    }
    "C-410" [shape="box", style="rounded", label="Load Workbench"];
    "VS-410c" [shape="box", style="rounded,dashed", label="Archived"];
    "VS-410d" [shape="box", style="rounded,dashed", label="Receipt delivered"];
    "VS-410e" [shape="box", style="rounded,dashed", label="Departure closed"];
    "VS-415a" [shape="box", style="rounded,dashed", label="Crew message"];
    "VS-415b" [shape="box", style="rounded,dashed", label="Crew review"];
    "VS-415c" [shape="box", style="rounded,dashed", label="Crew confirmation"];
  }
  "C-420" [shape="box", style="rounded", label="Cargo Sheet"];
  "C-430" [shape="box", style="rounded", label="Seal Check"];
  "C-431" [shape="box", style="rounded", label="Seal Code Input"];
  "C-440" [shape="box", style="rounded", label="Release Lever"];
  "C-450" [shape="box", style="rounded", label="Trail Lens"];
  "C-470" [shape="box", style="rounded", label="Arrival Review"];
  "P-410__anchor" -> "C-420" [style=invis, weight=100];
  "C-420" -> "C-430" [style=invis, weight=100];
  "C-430" -> "C-431" [style=invis, weight=100];
  "C-431" -> "C-440" [style=invis, weight=100];
  "C-440" -> "C-450" [style=invis, weight=100];
  "C-450" -> "C-470" [style=invis, weight=100];
  "P-410__anchor" -> "VS-410a__anchor" [style=invis, weight=100];
  "VS-410b__anchor" -> "C-410" [style=invis, weight=100];
  "C-410" -> "VS-410c" [style=invis, weight=100];
  "VS-410e" -> "VS-415a" [style=invis, weight=100];
  "VS-410a__anchor" -> "C-460" [style=invis, weight=100];
  "VS-410b__anchor" -> "C-460" [style=invis, weight=100];
  "VS-410a__anchor" -> "VS-410b__anchor" [label="[Release load] {seal_valid} / SA-440", style="solid", weight=4];
  "VS-410b__anchor" -> "VS-410c" [label="[Archive confirmed]", style="solid", weight=4];
  "VS-410c" -> "VS-410d" [label="[Receipt delivered]", style="solid", weight=4];
  "VS-410d" -> "VS-410e" [label="[Departure closed]", style="solid", weight=4];
  "VS-415a" -> "VS-415b" [label="[Crew review opened]", style="solid", weight=4];
  "VS-415b" -> "VS-415c" [label="[Crew note acknowledged]", style="solid", weight=4];
}
