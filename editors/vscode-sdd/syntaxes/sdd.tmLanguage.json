    "version-declaration": {
      "name": "meta.version.sdd",
      "match": "^(\\s*)(SDD-TEXT)(\\s+)([0-9][0-9.]*)\\s*$",
      "captures": {
        "2": {
          "name": "keyword.other.version.sdd"
        },
        "4": {
          "name": "constant.numeric.version.sdd"
        }
      }
    },
    "comment-line": {
      "name": "comment.line.number-sign.sdd",
      "match": "^\\s*(#).*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.sdd"
        }
      }
    },
    "line-comment": {
      "name": "comment.line.number-sign.sdd",
      "match": "(#).*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.sdd"
        }
      }
    },
    "quoted-string": {
      "name": "string.quoted.double.sdd",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sdd"
        }
      },
      "end": "(?:\"|$)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.sdd"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.sdd",
          "match": "(?:\\\\\\\\\"|\\\\\\\\)"
        }
      ]
    },
    "bare-value": {
      "name": "string.unquoted.bare.sdd",
      "match": "(?<![A-Za-z0-9_./:-])(?:[A-Za-z0-9_./:-]+)(?![A-Za-z0-9_./:-])"
    },
