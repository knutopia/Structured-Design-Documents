{
  "schema": "sdd-text",
  "version": "0.1",
  "nodes": [
    {
      "id": "C-410",
      "type": "Component",
      "name": "Load Workbench",
      "props": {
        "description": "Coordinate cargo editing, seal verification, release, and status review.",
        "inputs": "LoadRecord",
        "outputs": "LoadReady",
        "owner": "OperationsDesign",
        "responsibility": "Expose readiness for release while each child retains its own contracts."
      }
    },
    {
      "id": "C-420",
      "type": "Component",
      "name": "Cargo Sheet",
      "props": {
        "description": "Edit the item list while keeping the seal check within its local context.",
        "inputs": "LoadContents",
        "outputs": "CargoChanged",
        "owner": "OperationsDesign",
        "responsibility": "Capture cargo changes and store the current draft."
      }
    },
    {
      "id": "C-430",
      "type": "Component",
      "name": "Seal Check",
      "props": {
        "description": "Verify the entered seal code against the current load record.",
        "inputs": "SealCode",
        "outputs": "SealAccepted",
        "owner": "OperationsDesign",
        "responsibility": "Confirm the seal independently of cargo editing and emit its result."
      }
    },
    {
      "id": "C-431",
      "type": "Component",
      "name": "Seal Code Input",
      "props": {
        "description": "Accept the seal code printed on the loaded container.",
        "inputs": "SealCode",
        "outputs": "SealCodeEdited",
        "owner": "OperationsDesign",
        "responsibility": "Capture a seal code without deciding whether the load may depart."
      }
    },
    {
      "id": "C-440",
      "type": "Component",
      "name": "Release Lever",
      "props": {
        "description": "Offer the deliberate action that releases the prepared load.",
        "inputs": "ReleasePermission",
        "outputs": "ReleaseRequested",
        "owner": "OperationsDesign",
        "responsibility": "Emit the release request and invoke departure recording."
      }
    },
    {
      "id": "C-450",
      "type": "Component",
      "name": "Trail Lens",
      "props": {
        "description": "Show the load status alongside the stored draft context.",
        "inputs": "LoadStatus",
        "outputs": "StatusViewed",
        "owner": "OperationsDesign",
        "responsibility": "Present departure status using the draft service shared with Cargo Sheet."
      }
    },
    {
      "id": "C-460",
      "type": "Component",
      "name": "Crew Note",
      "props": {
        "description": "Present the crew handoff message in both Staging and Released.",
        "inputs": "CrewMessage",
        "outputs": "NoteAcknowledged",
        "owner": "OperationsDesign",
        "responsibility": "Keep the same message component recognizable across the two ViewState contexts."
      }
    },
    {
      "id": "C-470",
      "type": "Component",
      "name": "Arrival Review",
      "props": {
        "description": "Review the arrival handoff using the same seal-verification subtree.",
        "inputs": "ArrivalReceipt",
        "outputs": "ArrivalReviewed",
        "owner": "OperationsDesign",
        "responsibility": "Expose the existing seal check in a second component context without duplicating its identity."
      }
    },
    {
      "id": "D-410",
      "type": "DataEntity",
      "name": "LoadRecord",
      "props": {
        "description": "The load data shared by cargo editing, seal verification, and status review.",
        "fields": "load_id,contents,seal_code,status",
        "owner": "OperationsData",
        "system_of_record": "DepartureStore"
      }
    },
    {
      "id": "E-420",
      "type": "Event",
      "name": "Cargo changed",
      "props": {
        "description": "The operator changed the item list through Cargo Sheet.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,contents}",
        "source_kind": "user"
      }
    },
    {
      "id": "E-430",
      "type": "Event",
      "name": "Seal accepted",
      "props": {
        "description": "Seal Check accepted the current code for this load.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,seal_code}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-440",
      "type": "Event",
      "name": "Release load",
      "props": {
        "description": "The operator requested departure through Release Lever.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id}",
        "source_kind": "user"
      }
    },
    {
      "id": "E-450",
      "type": "Event",
      "name": "Checklist reviewed",
      "props": {
        "description": "The operator has completed a review of the departure checklist.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,checklist_id,reviewer_id}",
        "source_kind": "user"
      }
    },
    {
      "id": "E-460",
      "type": "Event",
      "name": "Checklist filed",
      "props": {
        "description": "The checklist workflow confirms that the reviewed checklist has been filed.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,checklist_id,filing_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-470",
      "type": "Event",
      "name": "Archive confirmed",
      "props": {
        "description": "The departure workflow confirms that the released load record has been archived.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,archive_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-480",
      "type": "Event",
      "name": "Crew review opened",
      "props": {
        "description": "The operator opened the crew handoff review.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,crew_message_id}",
        "source_kind": "user"
      }
    },
    {
      "id": "E-490",
      "type": "Event",
      "name": "Crew note acknowledged",
      "props": {
        "description": "The operator acknowledged the reviewed crew handoff note.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,crew_message_id,acknowledged_by}",
        "source_kind": "user"
      }
    },
    {
      "id": "E-500",
      "type": "Event",
      "name": "Release recorded",
      "props": {
        "description": "The departure system confirms that the accepted load release was recorded.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,departure_record_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-510",
      "type": "Event",
      "name": "Handoff completed",
      "props": {
        "description": "The receiving workflow confirms completion of the released load handoff.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,handoff_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-520",
      "type": "Event",
      "name": "Receipt delivered",
      "props": {
        "description": "The departure system confirms delivery of the archived departure receipt.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,receipt_id,delivery_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-530",
      "type": "Event",
      "name": "Departure closed",
      "props": {
        "description": "The departure system confirms closure of the record after receipt delivery.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,closure_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-540",
      "type": "Event",
      "name": "Result applied",
      "props": {
        "description": "The seal workflow confirms that the verified result has been applied to the current load.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,seal_code,result_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-550",
      "type": "Event",
      "name": "Result acknowledged",
      "props": {
        "description": "The receiving workflow confirms acknowledgement of the applied seal result.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,result_id,acknowledgement_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "E-560",
      "type": "Event",
      "name": "Check filed",
      "props": {
        "description": "The seal workflow confirms that the acknowledged result has been filed.",
        "owner": "OperationsDesign",
        "payload_schema": "{load_id,result_id,filing_id}",
        "source_kind": "system"
      }
    },
    {
      "id": "P-410",
      "type": "Place",
      "name": "Departure Desk",
      "props": {
        "access": "auth",
        "description": "Prepare a loaded container for departure and record its release.",
        "entry_points": "link:/departures",
        "owner": "OperationsDesign",
        "primary_nav": "true",
        "route_or_key": "/departures",
        "surface": "web"
      }
    },
    {
      "id": "SA-410",
      "type": "SystemAction",
      "name": "Store draft",
      "props": {
        "action": "storeLoadDraft",
        "description": "Persist the prepared load draft used by Cargo Sheet and Trail Lens.",
        "failure_modes": "timeout,revision_conflict",
        "owner": "DepartureEngineering",
        "system_name": "DepartureAPI"
      }
    },
    {
      "id": "SA-430",
      "type": "SystemAction",
      "name": "Check seal",
      "props": {
        "action": "verifyLoadSeal",
        "description": "Check that the supplied seal code belongs to the current load.",
        "failure_modes": "timeout,seal_mismatch",
        "owner": "DepartureEngineering",
        "system_name": "DepartureAPI"
      }
    },
    {
      "id": "SA-440",
      "type": "SystemAction",
      "name": "Record departure",
      "props": {
        "action": "recordLoadDeparture",
        "description": "Record that the prepared load has been released.",
        "failure_modes": "timeout,already_released",
        "owner": "DepartureEngineering",
        "system_name": "DepartureAPI"
      }
    },
    {
      "id": "ST-410a",
      "type": "State",
      "name": "Assembling",
      "props": {
        "description": "The load is being prepared and is not yet ready for release.",
        "invariants": "Release readiness has not been confirmed.",
        "owner": "OperationsDesign",
        "scope_id": "C-410"
      }
    },
    {
      "id": "ST-410b",
      "type": "State",
      "name": "Ready to release",
