        "description": "Turn a household priority into a practical next step",
        "order_index": "10",
        "owner": "EnergyServices"
      }
    },
    {
      "id": "J-400",
      "type": "Step",
      "name": "Choose the main priority",
      "props": {
        "actor": "Homeowner",
        "description": "Choose the household outcome that matters most right now",
        "intent": "Focus the planning effort on a meaningful goal",
        "kind": "decision",
        "owner": "EnergyServices",
        "success_criteria": "One priority guides the next exploration"
      }
    },
    {
      "id": "J-410",
      "type": "Step",
      "name": "Explore lower energy bills",
      "props": {
        "actor": "Homeowner",
        "description": "Examine where household energy costs are concentrated",
        "intent": "Find realistic ways to reduce recurring costs",
        "owner": "EnergyServices",
        "success_criteria": "The major cost drivers are understood"
      }
    },
    {
      "id": "J-411",
      "type": "Step",
      "name": "Review usage opportunities",
      "props": {
        "actor": "Homeowner",
        "description": "Compare behavior and equipment changes that could lower usage",
        "intent": "Choose a manageable cost-saving action",
        "owner": "EnergyServices",
        "success_criteria": "A credible savings opportunity is identified"
      }
    },
    {
      "id": "J-420",
      "type": "Step",
      "name": "Explore better home comfort",
      "props": {
        "actor": "Homeowner",
        "description": "Describe rooms that are too hot, cold, damp, or drafty",
        "intent": "Understand why the home feels uncomfortable",
        "owner": "EnergyServices",
        "success_criteria": "The most important comfort symptoms are captured"
      }
    },
    {
      "id": "J-421",
