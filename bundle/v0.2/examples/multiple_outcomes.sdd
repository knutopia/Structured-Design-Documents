  owner="Customer success"
  release_slice="Post-setup ownership"
  description="Create an explicit post-setup handoff path for first-week ownership."
  non_goals="Does not replace existing analytics or support reporting"
  status="candidate"
  ADDRESSES OP-007 "Handoff gaps hide next ownership"
  ADDRESSES OP-004 "Exception handling requires support escalation"
END
Opportunity OP-001 "Users cannot see which setup steps matter"
  evidence="Setup interviews show teams complete low-impact steps first"
  segment="New admin teams"
  owner="Product discovery"
  description="Setup work is not prioritized by expected value, so teams spend energy on low-impact configuration first."
  severity="high"
  SUPPORTS O-001 "Shorten time to first value"
  SUPPORTS O-002 "Increase self-serve task completion"
END
Opportunity OP-002 "Imported data quality issues appear too late"
  evidence="Import errors often surface only after workflow configuration"
  segment="Teams migrating existing records"
  owner="Product discovery"
  description="Import health checks arrive too late to prevent downstream rework and loss of confidence."
  severity="high"
  SUPPORTS O-001 "Shorten time to first value"
  SUPPORTS O-003 "Improve trust in automated recommendations"
END
Opportunity OP-003 "Terminology does not match the team workflow"
  evidence="Users pause when product labels conflict with internal roles"
  segment="Specialized operations teams"
  owner="Product discovery"
  description="The product language does not reflect local operating models, increasing hesitation and mistakes."
  severity="medium"
  SUPPORTS O-002 "Increase self-serve task completion"
END
Opportunity OP-004 "Exception handling requires support escalation"
  evidence="Support logs cluster around recoverable configuration exceptions"
  segment="High-volume task owners"
  owner="Product discovery"
  description="Recoverable exceptions leave users without a clear next action inside the product."
  severity="high"
  SUPPORTS O-002 "Increase self-serve task completion"
END
Opportunity OP-005 "Recommendation evidence is hard to audit"
  evidence="Reviewers ask why recommendations changed before accepting them"
  segment="Compliance-sensitive teams"
  owner="Product discovery"
  description="Recommendation rationale and evidence are not visible enough for accountable review."
  severity="high"
  SUPPORTS O-003 "Improve trust in automated recommendations"
END
Opportunity OP-006 "Teams need rollout controls before trusting automation"
  evidence="Pilot users request canary and override paths before enabling automation"
  segment="Enterprise governance teams"
  owner="Product discovery"
  description="Governed teams need staged enablement, override, and rollback controls before they trust automation."
  severity="medium"
  SUPPORTS O-002 "Increase self-serve task completion"
  SUPPORTS O-003 "Improve trust in automated recommendations"
END
Opportunity OP-007 "Handoff gaps hide next ownership"
  evidence="Setup owners do not know who should monitor the first live week"
  segment="Multi-role rollout teams"
  owner="Product discovery"
  description="Ownership after setup is ambiguous, so first-week monitoring and follow-up work are missed."
  severity="medium"
  SUPPORTS O-001 "Shorten time to first value"
  SUPPORTS O-002 "Increase self-serve task completion"
END
Opportunity OP-008 "Outcome history is not visible at review time"
  evidence="Decision reviewers open analytics in a separate workflow to compare history"
  segment="Recurring business review teams"
  owner="Product discovery"
  description="Reviewers cannot see prior outcome movement where recommendation decisions happen."
  severity="medium"
  SUPPORTS O-003 "Improve trust in automated recommendations"
END
Outcome O-001 "Shorten time to first value"
  target="Reduce median first-value time from 9 days to 3 days"
  timeframe="Q3 pilot"
  owner="Product strategy"
  description="New admin teams reach a meaningful completed workflow faster after setup begins."
  time_horizon="Q3 pilot"
  scope="Activation and task completion workflows"
  stakeholder="New workspace admins"
  MEASURED_BY M-001 "Median days to first completed workflow"
  MEASURED_BY M-002 "Activation completion rate"
END
Outcome O-002 "Increase self-serve task completion"
  target="Lift completion without support from 62 percent to 78 percent"
  timeframe="Q3 pilot"
  owner="Product strategy"
  description="Task owners can finish recoverable work without waiting for support or specialist intervention."
  time_horizon="Q3 pilot"
  scope="Activation and task completion workflows"
  stakeholder="Task owners and support leads"
  MEASURED_BY M-003 "Self-serve task completion rate"
  MEASURED_BY M-004 "Support deflection for recoverable tasks"
END
Outcome O-003 "Improve trust in automated recommendations"
  target="Raise accepted recommendations while lowering reversals"
  timeframe="Q4 governance release"
  owner="Product strategy"
  description="Reviewers understand, accept, and retain automated recommendations in governed workflows."
  time_horizon="Q4 governance release"
  scope="Recommendation review and governance workflows"
  stakeholder="Decision reviewers and governance owners"
  MEASURED_BY M-005 "Recommendation acceptance rate"
  MEASURED_BY M-006 "Recommendation reversal rate"
END
Metric M-001 "Median days to first completed workflow"
  cadence="Weekly cohort"
  owner="Product analytics"
  description="Tracks elapsed calendar days from workspace creation to the first completed workflow."
  definition="Median calendar days from account creation to first completed workflow event."
  source="Activation event stream"
  metric_type="outcome"
END
Metric M-002 "Activation completion rate"
  cadence="Weekly cohort"
  owner="Product analytics"
  description="Tracks the share of accounts completing the required activation path."
  definition="Activated accounts divided by eligible accounts entering setup within the cohort window."
  source="Setup funnel warehouse table"
  metric_type="outcome"
END
Metric M-003 "Self-serve task completion rate"
  cadence="Weekly task funnel"
  owner="Product analytics"
  description="Tracks the share of eligible tasks completed without assisted support."
  definition="Eligible recoverable tasks completed in product divided by total eligible recoverable tasks."
  source="Task completion event stream"
  metric_type="outcome"
END
Metric M-004 "Support deflection for recoverable tasks"
  cadence="Monthly support report"
  owner="Product analytics"
  description="Tracks recoverable-task support contacts avoided by self-serve recovery paths."
  definition="Support cases avoided for tagged recoverable tasks compared with the trailing baseline."
  source="Support case tags and task events"
  metric_type="outcome"
END
Metric M-005 "Recommendation acceptance rate"
  cadence="Weekly decision sample"
  owner="Product analytics"
  description="Tracks the share of shown recommendations accepted by accountable reviewers."
  definition="Accepted recommendations divided by recommendations shown to reviewers."
  source="Recommendation decision events"
  metric_type="outcome"
END
Metric M-006 "Recommendation reversal rate"
  cadence="Weekly decision sample"
  owner="Product analytics"
  description="Tracks accepted recommendations later reversed or overridden by reviewers."
  definition="Accepted recommendations later reversed divided by accepted recommendations."
  source="Recommendation audit log"
  metric_type="guardrail"
END
