  "nodes": [
    {
      "id": "G-001",
      "type": "Stage",
      "name": "Maintain Product Map",
      "props": {
        "description": "Maintain a map of the existing product",
        "order_index": "1",
        "owner": "Product"
      }
    },
    {
      "id": "PR-001",
      "type": "Process",
      "name": "Support Product Map Interaction",
      "props": {
        "description": "Support the product-map interaction steps represented by this topology example",
        "owner": "Product",
        "sla": "interactive",
        "visibility": "frontstage"
      }
    },
    {
      "id": "S-010",
      "type": "ScenarioStep",
      "name": "Select a Node",
      "props": {
        "actor": "Designer",
        "description": "Select a Node in Source viewer or in Diagram viewer",
        "intent": "Select product-map content for inspection",
        "owner": "Product",
        "success_criteria": "A node is selected"
      }
    },
    {
      "id": "S-020",
      "type": "ScenarioStep",
      "name": "Review Diagrams Containing Current Node",
      "props": {
        "actor": "Designer",
        "description": "See the set of diagrams in which the current node appears",
        "intent": "Review diagrams containing the selected node",
        "owner": "Product",
        "success_criteria": "Relevant diagrams are visible"
      }
    },
    {
      "id": "S-021",
      "type": "ScenarioStep",
      "name": "Select Diagram",
      "props": {
        "actor": "Designer",
        "description": "Choose a diagram in which the node is used",
        "intent": "Choose a diagram containing the node",
        "owner": "Product",
        "success_criteria": "A diagram is selected"
      }
    },
    {
      "id": "S-022",
      "type": "ScenarioStep",
      "name": "View Node in New Diagram Context",
      "props": {
        "actor": "Designer",
        "description": "View the chosen diagram using the current node",
        "intent": "View the node in the chosen diagram",
        "owner": "Product",
        "success_criteria": "The selected context is displayed"
      }
    },
    {
      "id": "S-030",
      "type": "ScenarioStep",
      "name": "Select Diagram Content",
      "props": {
        "actor": "Designer",
        "description": "Select a node or multiple nodes in a diagram",
        "intent": "Select diagram content for a saved view",
        "owner": "Product",
        "success_criteria": "The intended content is selected"
      }
    },
    {
      "id": "S-031",
      "type": "ScenarioStep",
      "name": "Adjust View",
      "props": {
        "actor": "Designer",
        "description": "Make the view just right",
        "intent": "Adjust the diagram view",
        "owner": "Product",
        "success_criteria": "The view is ready to save"
      }
    },
    {
      "id": "S-032",
      "type": "ScenarioStep",
      "name": "Name the New View",
      "props": {
        "actor": "Designer",
        "description": "Enter a name for the new view",
        "intent": "Name the adjusted view",
        "owner": "Product",
        "success_criteria": "The new view has a name"
      }
    },
    {
      "id": "S-040",
      "type": "ScenarioStep",
      "name": "Add Relationship",
      "props": {
        "actor": "Designer",
        "description": "Add a relationship to an existing node",
        "intent": "Add a relationship to an existing node",
        "owner": "Product",
        "success_criteria": "A relationship-creation path is chosen"
      }
    },
    {
      "id": "S-041",
      "type": "ScenarioStep",
      "name": "Add relationship, by node",
      "props": {
        "actor": "Designer",
        "description": "Add relationship, by choosing another node first (incoming or outgoing)",
        "intent": "Choose another node before setting direction",
        "owner": "Product",
        "success_criteria": "The related node is selected"
      }
    },
    {
      "id": "S-042",
      "type": "ScenarioStep",
      "name": "Add outgoing relationship",
      "props": {
        "actor": "Designer",
        "description": "Add outgoing relationship, by choosing the relationship type or a node first",
        "intent": "Create an outgoing relationship",
        "owner": "Product",
        "success_criteria": "An outgoing relationship is defined"
      }
    },
    {
      "id": "S-043",
      "type": "ScenarioStep",
      "name": "Add incoming relationship",
      "props": {
        "actor": "Designer",
        "description": "Add incoming relationship, by choosing the relationship type or a node first",
        "intent": "Create an incoming relationship",
        "owner": "Product",
        "success_criteria": "An incoming relationship is defined"
      }
    }
